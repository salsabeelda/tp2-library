
@startuml
left to right direction

' Actors
actor User
actor Member
actor Librarian
rectangle "Mail server" as Mail <<actor>>

' Generalization
User <|-- Member
User <|-- Librarian

rectangle "Library system" {

    ' Use cases
    usecase "Search the catalog" as Search
    usecase "Reserve a book" as Reserve
    usecase "Renew a loan" as Renew
    usecase "Register a loan" as Lend
    usecase "Check borrowing rights" as Check

    usecase Return as "Register a return
    --
    extension points
    late return"

    usecase "Suspend the member" as Suspend
    usecase "Manage the catalog" as Manage

    ' Include relationships
    Renew ..> Check : <<include>>
    Lend ..> Check : <<include>>

    ' Extend relationship
    Suspend ..> Return : <<extend>>

    ' Extension condition
    note right of Return
        condition: {returned late}
        extension point: late return
    end note
}

' Associations
User -- Search

Member -- Reserve
Member -- Renew

Librarian -- Lend
Librarian -- Return
Librarian -- Manage

Mail -- Reserve

@enduml

